# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vyrtium_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication (Dual Token Architecture)
JWT_SECRET=super_secret_access_jwt_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend Email Notifications (Bonus)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Vyrtium <onboarding@resend.dev>

# CORS Configuration
FRONTEND_URL=http://localhost:3000
